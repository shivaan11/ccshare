# Supabase project (safe to expose — protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) or legacy anon JWT — either works
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used exclusively by API routes for workspace management.
# Never referenced from client code; never leaves Vercel/server env.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical URL of this deployment (used for auth redirects, invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
